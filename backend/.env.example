# --- Smart Money backend environment ---
APP_NAME=Smart Money
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
LOG_LEVEL=INFO

# SQLite by default; swap for postgres+psycopg://... in production.
DATABASE_URL=sqlite:///./smart_money.db

# --- Anthropic / CrewAI ---
# Leave empty to run the deterministic heuristic engine (no LLM calls needed).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022
USE_LLM=true

# --- Real market data ---
# yfinance (Yahoo) is used automatically, no key. Optionally add a free Finnhub
# key (https://finnhub.io) for a more reliable real-data source on cloud hosts.
FINNHUB_API_KEY=

# --- Pappers : données légales & financières des entreprises françaises ---
# Clé gratuite (quota limité) sur https://www.pappers.fr/api
PAPPERS_API_KEY=

# --- Scan defaults (CSV) ---
DEFAULT_UNIVERSE=AAPL,MSFT,NVDA,GOOGL,AMZN,META,TSLA,AMD,CRM,SHOP
MIN_MARKET_CAP=500000000
MAX_PE=120
EXCLUDED_SECTORS=

# CORS (CSV of origins, or *)
CORS_ORIGINS=*

# Autoriser les scans à interroger les sources externes (yfinance, GDELT,
# DuckDuckGo, Pappers). Mettre à false pour un fonctionnement 100% hors-ligne.
ENABLE_NETWORK=true

# Note : les actualités géopolitiques (GDELT) sont GRATUITES et sans clé —
# elles fonctionnent automatiquement dès que le serveur a accès à internet.
