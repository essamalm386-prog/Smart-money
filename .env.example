# Root convenience env — copy to backend/.env before running docker compose.
# See backend/.env.example for the full annotated list.
ANTHROPIC_API_KEY=
USE_LLM=true
LLM_MODEL=claude-3-5-sonnet-20241022
DATABASE_URL=sqlite:////data/smart_money.db
DEFAULT_UNIVERSE=AAPL,MSFT,NVDA,GOOGL,AMZN,META,TSLA,AMD,CRM,SHOP
MIN_MARKET_CAP=500000000
MAX_PE=120
CORS_ORIGINS=*
